# Supabase projekt URL és kulcsok — Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# CSAK szerver oldalon használt, SOHA ne kerüljön a böngészőbe / git-be éles kulccsal.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Visszaigazoló email küldéséhez — resend.com, ingyenes csomaggal is működik.
# API kulcs: Resend Dashboard > API Keys.
RESEND_API_KEY=re_xxxxxxxxxxxx
# A küldő cím: a domain-t előbb hitelesítened kell a Resend-ben (Domains menü),
# amíg ez nincs kész, tesztelésre használható a Resend saját onboarding@resend.dev címe is.
BOOKING_EMAIL_FROM="Noir Atelier <foglalas@noiratelier.hu>"
